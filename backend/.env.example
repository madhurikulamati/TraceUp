# TraceUp Backend Environment Variables Example
DJANGO_SECRET_KEY=django-insecure-find-my-device-backend-secret-key-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=find_my_device
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=False

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
USE_FAKE_REDIS=False
USE_INMEMORY_CHANNEL_LAYER=False

# Firebase Cloud Messaging (FCM) Configuration
# Absolute or relative path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=secrets/serviceAccountKey.json
